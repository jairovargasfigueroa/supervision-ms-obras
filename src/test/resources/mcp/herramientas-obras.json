[ {
  "name" : "avance_obra",
  "title" : "Avance de obras",
  "description" : "Devuelve el avance físico y el plazo transcurrido de las obras, al día. Sin obraId devuelve las obras en ejecución ordenadas de la más atrasada a la menos. Con obraId devuelve además sus partidas y, si se indica periodo, el material previsto de ese periodo.",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "obraId" : {
        "type" : "string",
        "format" : "uuid",
        "pattern" : "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description" : "Id de la obra. Sin obraId devuelve las obras en ejecución."
      },
      "periodo" : {
        "type" : "string",
        "pattern" : "^\\d{4}-(0[1-9]|1[0-2])$",
        "description" : "Mes AAAA-MM del material previsto. Solo junto con obraId."
      }
    },
    "additionalProperties" : false
  },
  "outputSchema" : {
    "$schema" : "https://json-schema.org/draft/2020-12/schema",
    "type" : "object",
    "properties" : {
      "generadoEn" : {
        "type" : "string"
      },
      "hayPlanillaEnPeriodo" : {
        "type" : [ "boolean", "null" ]
      },
      "obras" : {
        "type" : "array",
        "items" : {
          "type" : "object",
          "properties" : {
            "avancePct" : {
              "type" : "number"
            },
            "diferencia" : {
              "type" : "number"
            },
            "enRiesgo" : {
              "type" : "boolean"
            },
            "estado" : {
              "type" : "string"
            },
            "fechaInicio" : {
              "type" : "string"
            },
            "nombre" : {
              "type" : "string"
            },
            "obraId" : {
              "type" : "string"
            },
            "partidas" : {
              "type" : [ "array", "null" ],
              "items" : {
                "type" : "object",
                "properties" : {
                  "avancePct" : {
                    "type" : "number"
                  },
                  "cantidadContratada" : {
                    "type" : "number"
                  },
                  "codigo" : {
                    "type" : "string"
                  },
                  "ejecutadaAcumulada" : {
                    "type" : "number"
                  },
                  "materialPrevisto" : {
                    "type" : [ "array", "null" ],
                    "items" : {
                      "type" : "object",
                      "properties" : {
                        "cantidadPrevista" : {
                          "type" : "number"
                        },
                        "materialId" : {
                          "type" : "string"
                        }
                      },
                      "required" : [ "cantidadPrevista", "materialId" ],
                      "additionalProperties" : false
                    }
                  },
                  "nombre" : {
                    "type" : "string"
                  },
                  "partidaId" : {
                    "type" : "string"
                  },
                  "unidad" : {
                    "type" : "string"
                  }
                },
                "required" : [ "avancePct", "cantidadContratada", "codigo", "ejecutadaAcumulada", "materialPrevisto", "nombre", "partidaId", "unidad" ],
                "additionalProperties" : false
              }
            },
            "plazoDias" : {
              "type" : "integer",
              "format" : "int32"
            },
            "plazoPct" : {
              "type" : "number"
            },
            "ultimaPlanilla" : {
              "type" : [ "object", "null" ],
              "properties" : {
                "estado" : {
                  "type" : "string"
                },
                "periodo" : {
                  "type" : "string"
                }
              },
              "required" : [ "estado", "periodo" ],
              "additionalProperties" : false
            }
          },
          "required" : [ "avancePct", "diferencia", "enRiesgo", "estado", "fechaInicio", "nombre", "obraId", "partidas", "plazoDias", "plazoPct", "ultimaPlanilla" ],
          "additionalProperties" : false
        }
      },
      "truncado" : {
        "type" : "boolean"
      }
    },
    "required" : [ "generadoEn", "hayPlanillaEnPeriodo", "obras", "truncado" ],
    "additionalProperties" : false
  },
  "annotations" : {
    "title" : "Avance de obras",
    "readOnlyHint" : true,
    "destructiveHint" : false,
    "idempotentHint" : true,
    "openWorldHint" : false
  }
}, {
  "name" : "buscar_diario",
  "title" : "Diario de obra",
  "description" : "Devuelve las entradas del diario de obra (clima y texto) de una obra en un rango de fechas, opcionalmente filtradas por una palabra. Sirve para buscar la causa de un atraso.",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "obraId" : {
        "type" : "string",
        "format" : "uuid",
        "pattern" : "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description" : "Id de la obra."
      },
      "desde" : {
        "type" : "string",
        "format" : "date",
        "pattern" : "^\\d{4}-\\d{2}-\\d{2}$",
        "description" : "Primera fecha AAAA-MM-DD. Por defecto, hoy menos 14 días."
      },
      "hasta" : {
        "type" : "string",
        "format" : "date",
        "pattern" : "^\\d{4}-\\d{2}-\\d{2}$",
        "description" : "Última fecha AAAA-MM-DD. Por defecto, hoy. Rango máximo: 62 días."
      },
      "texto" : {
        "type" : "string",
        "minLength" : 2,
        "maxLength" : 50,
        "description" : "Palabra que debe contener el texto de la entrada, sin distinguir mayúsculas."
      },
      "limite" : {
        "type" : "integer",
        "minimum" : 1,
        "maximum" : 30,
        "default" : 14,
        "description" : "Entradas máximas."
      }
    },
    "required" : [ "obraId" ],
    "additionalProperties" : false
  },
  "outputSchema" : {
    "$schema" : "https://json-schema.org/draft/2020-12/schema",
    "type" : "object",
    "properties" : {
      "entradas" : {
        "type" : "array",
        "items" : {
          "type" : "object",
          "properties" : {
            "clima" : {
              "type" : "string"
            },
            "fecha" : {
              "type" : "string"
            },
            "texto" : {
              "type" : "string"
            },
            "truncado" : {
              "type" : "boolean"
            }
          },
          "required" : [ "clima", "fecha", "texto", "truncado" ],
          "additionalProperties" : false
        }
      },
      "obraId" : {
        "type" : "string"
      },
      "total" : {
        "type" : "integer",
        "format" : "int64"
      },
      "truncado" : {
        "type" : "boolean"
      }
    },
    "required" : [ "entradas", "obraId", "total", "truncado" ],
    "additionalProperties" : false
  },
  "annotations" : {
    "title" : "Diario de obra",
    "readOnlyHint" : true,
    "destructiveHint" : false,
    "idempotentHint" : true,
    "openWorldHint" : false
  }
}, {
  "name" : "planillas_estado",
  "title" : "Estado de las planillas",
  "description" : "Devuelve las planillas de avance, al día, con su estado, neto, observación y días desde que se presentaron. Sirve para detectar planillas pendientes o sin respuesta del cliente.",
  "inputSchema" : {
    "type" : "object",
    "properties" : {
      "obraId" : {
        "type" : "string",
        "format" : "uuid",
        "pattern" : "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
        "description" : "Id de la obra. Sin obraId, las planillas de todas las obras."
      },
      "estados" : {
        "type" : "array",
        "minItems" : 1,
        "maxItems" : 5,
        "uniqueItems" : true,
        "items" : {
          "type" : "string",
          "enum" : [ "BORRADOR", "PRESENTADA", "APROBANDO", "APROBADA", "OBSERVADA" ]
        },
        "description" : "Estados que se devuelven. Por defecto, todos menos APROBADA."
      },
      "desdePeriodo" : {
        "type" : "string",
        "pattern" : "^\\d{4}-(0[1-9]|1[0-2])$",
        "description" : "Mes AAAA-MM desde el que se devuelven planillas (incluido)."
      },
      "limite" : {
        "type" : "integer",
        "minimum" : 1,
        "maximum" : 50,
        "default" : 30,
        "description" : "Planillas máximas."
      }
    },
    "additionalProperties" : false
  },
  "outputSchema" : {
    "$schema" : "https://json-schema.org/draft/2020-12/schema",
    "type" : "object",
    "properties" : {
      "planillas" : {
        "type" : "array",
        "items" : {
          "type" : "object",
          "properties" : {
            "cobroId" : {
              "type" : [ "string", "null" ]
            },
            "diasDesdePresentacion" : {
              "type" : [ "integer", "null" ],
              "format" : "int64"
            },
            "estado" : {
              "type" : "string"
            },
            "neto" : {
              "type" : "number"
            },
            "numero" : {
              "type" : "integer",
              "format" : "int32"
            },
            "obraId" : {
              "type" : "string"
            },
            "obraNombre" : {
              "type" : "string"
            },
            "observacion" : {
              "type" : [ "string", "null" ]
            },
            "periodo" : {
              "type" : "string"
            },
            "planillaId" : {
              "type" : "string"
            },
            "presentadaEn" : {
              "type" : [ "string", "null" ]
            }
          },
          "required" : [ "cobroId", "diasDesdePresentacion", "estado", "neto", "numero", "obraId", "obraNombre", "observacion", "periodo", "planillaId", "presentadaEn" ],
          "additionalProperties" : false
        }
      },
      "truncado" : {
        "type" : "boolean"
      }
    },
    "required" : [ "planillas", "truncado" ],
    "additionalProperties" : false
  },
  "annotations" : {
    "title" : "Estado de las planillas",
    "readOnlyHint" : true,
    "destructiveHint" : false,
    "idempotentHint" : true,
    "openWorldHint" : false
  }
} ]