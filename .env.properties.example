# Copiar a .env.properties y completar. .env.properties no se sube al repositorio.
# Valores de desarrollo: docs/entorno-local.md de supervision-docs; contraseñas de infra/.env.
OBRAS_PORT=8081
OBRAS_DB_HOST=localhost
OBRAS_DB_PORT=5433
OBRAS_DB_NAME=obras_db
OBRAS_DB_USER=obras
OBRAS_DB_PASSWORD=
OBRAS_KEYCLOAK_ISSUER=http://localhost:8080/realms/supervision
OBRAS_RABBITMQ_HOST=localhost
OBRAS_RABBITMQ_PORT=5672
OBRAS_RABBITMQ_USER=obras
# Clave del usuario obras de RabbitMQ: RABBITMQ_OBRAS_CLAVE de infra/.env
OBRAS_RABBITMQ_PASSWORD=
OBRAS_S3_REGION=sa-east-1
OBRAS_S3_ACCESS_KEY=
OBRAS_S3_SECRET_KEY=
OBRAS_S3_BUCKET=
OBRAS_CORS_ORIGENES=http://localhost:4300
