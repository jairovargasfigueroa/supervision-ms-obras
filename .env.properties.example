# Copiar a .env.properties y completar. .env.properties no se sube al repositorio.
# Valores de desarrollo: docs/entorno-local.md de supervision-docs; contraseñas de infra/.env.
OBRAS_PORT=8081
OBRAS_DB_HOST=localhost
OBRAS_DB_PORT=5433
OBRAS_DB_NAME=obras_db
OBRAS_DB_USER=obras
OBRAS_DB_PASSWORD=
# TLS con PostgreSQL (601): prefer en desarrollo; require en la nube (verify-full no: la imagen no trae el certificado raíz del proveedor)
OBRAS_DB_SSLMODE=prefer
OBRAS_KEYCLOAK_ISSUER=http://localhost:8080/realms/supervision
OBRAS_RABBITMQ_HOST=localhost
OBRAS_RABBITMQ_PORT=5672
OBRAS_RABBITMQ_USER=obras
# Clave del usuario obras de RabbitMQ: RABBITMQ_OBRAS_CLAVE de infra/.env
OBRAS_RABBITMQ_PASSWORD=
# TLS con RabbitMQ (601): true en la nube y en la producción local (con OBRAS_RABBITMQ_PORT=5671)
OBRAS_RABBITMQ_SSL=false
# S3 compatible (601, por ejemplo MinIO en la producción local); vacío = Amazon S3
OBRAS_S3_ENDPOINT=
OBRAS_S3_REGION=sa-east-1
OBRAS_S3_ACCESS_KEY=
OBRAS_S3_SECRET_KEY=
OBRAS_S3_BUCKET=
OBRAS_CORS_ORIGENES=http://localhost:4300
# Modo producción (601): la imagen trae prod; en desarrollo no se usa
# SPRING_PROFILES_ACTIVE=prod
# Datos de demostración (601): con el perfil prod o una base que no es local, la semilla solo carga si SEMILLA_DEMO=si
# SEMILLA_DEMO=
